# Ledgerly Environment Configuration Blueprint
# Copy this file to .env and provide your actual secrets locally or in your deployment dashboard.
# NEVER commit a real .env file with secrets to GitHub.

# Database: Hosted PostgreSQL connection string (Supabase, Neon, AWS RDS, etc.)
DATABASE_URL=postgresql://user:password@host:5432/ledgerly?sslmode=require

# Authentication: Secure JWT signing key (minimum 32 characters)
JWT_SECRET=replace-with-a-long-random-production-secret

# Application URL (used for password reset links & email notifications)
APP_URL=http://localhost:3000

# Runtime Environment
NODE_ENV=development
PORT=3000

# Optional: AI Integration for receipt OCR and statement parsing
OPENAI_API_KEY=

# Optional: Transaction notification emails (Resend API)
RESEND_API_KEY=
FROM_EMAIL=notifications@your-domain.example
