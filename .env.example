# Ledgerly environment configuration
# Never commit a real .env file or any real secret.

# Required in production: hosted PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/ledgerly?sslmode=require

# Required in production: generate a unique random value of 32+ characters
JWT_SECRET=replace-with-a-long-random-production-secret

# Public application URL used in password-reset emails
APP_URL=http://localhost:3000

# Runtime
NODE_ENV=development
PORT=3000

# Optional AI integration for receipt OCR and statement parsing
OPENAI_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional email integration
RESEND_API_KEY=
FROM_EMAIL=notifications@your-domain.example

# Optional OAuth integration
VITE_APP_ID=ledgerly
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
